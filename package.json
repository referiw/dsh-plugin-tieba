{
  "name": "dsh-plugin-tieba",
  "version": "0.1.0",
  "description": "只读百度贴吧的 DeepSeek Harness 插件：全量翻页、动态抽样、楼中楼、按楼层取图",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/referiw/dsh-plugin-tieba.git"
  },
  "homepage": "https://github.com/referiw/dsh-plugin-tieba#readme",
  "bugs": {
    "url": "https://github.com/referiw/dsh-plugin-tieba/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tieba",
    "baidu",
    "scraper"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "tieba": "./src/cli.mjs"
  },
  "files": [
    "lib/",
    "src/",
    "scripts/",
    "icon.svg",
    "locale/",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-browser.mjs",
    "setup": "node scripts/ensure-browser.mjs",
    "login": "node src/login.mjs",
    "status": "node src/cli.mjs status"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  }
}
